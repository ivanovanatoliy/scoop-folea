{
  "version": "0.0.0-git.20260719091902.c00000073.eeb29ad",
  "description": "Keyboard-driven, minimalist note manager for Typst notes",
  "homepage": "https://github.com/ivanovanatoliy/folea",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/ivanovanatoliy/folea/archive/eeb29adeffdff97210c271a2ab72dd8bae935c25.zip",
      "hash": "9e1070b271485bc44db73c7911d3377557293d229f92ebc00fa3ce789f2e5a79",
      "extract_dir": "folea-eeb29adeffdff97210c271a2ab72dd8bae935c25"
    }
  },
  "depends": "nodejs22",
  "installer": {
    "script": [
      "Push-Location $dir",
      "$env:CSC_IDENTITY_AUTO_DISCOVERY = 'false'",
      "$env:FOLEA_COMMIT_SHA = 'eeb29adeffdff97210c271a2ab72dd8bae935c25'",
      "$env:FOLEA_COMMIT_COUNT = '73'",
      "$env:FOLEA_BUILD_TIMESTAMP = '20260719091902'",
      "$env:FOLEA_SOURCE_BRANCH = 'develop'",
      "$env:FOLEA_WORKFLOW_RUN_URL = 'https://github.com/ivanovanatoliy/folea/actions/runs/29681354216'",
      "$builtVersion = node scripts/prepare-development-build.mjs",
      "if ($builtVersion -ne '0.0.0-git.20260719091902.c00000073.eeb29ad') { throw \"Unexpected build version: $builtVersion\" }",
      "npm ci",
      "npm version $builtVersion --no-git-tag-version --allow-same-version",
      "npm run build",
      "npx electron-builder --dir --win --x64 --publish never",
      "Pop-Location",
      "Move-Item -LiteralPath (Join-Path $dir 'dist\\win-unpacked') -Destination (Join-Path $dir 'app')",
      "Get-ChildItem -LiteralPath $dir -Force | Where-Object Name -ne 'app' | Remove-Item -Recurse -Force"
    ]
  },
  "bin": [["app\\folea.exe", "folea"]],
  "shortcuts": [["app\\folea.exe", "folea"]]
}
