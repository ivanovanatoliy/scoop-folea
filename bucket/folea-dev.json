{
  "version": "0.0.0-git.20260719070635.c00000069.e80b00b",
  "description": "Keyboard-driven, minimalist note manager for Typst notes",
  "homepage": "https://github.com/ivanovanatoliy/folea",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/ivanovanatoliy/folea/archive/e80b00ba257bde6b05b9cfaea20046a0270ecc85.zip",
      "hash": "e3bccf8125e007bc9734909ac1405184133781160e92f3ec0c7453b77f70a040",
      "extract_dir": "folea-e80b00ba257bde6b05b9cfaea20046a0270ecc85"
    }
  },
  "depends": "nodejs22",
  "installer": {
    "script": [
      "Push-Location $dir",
      "$env:CSC_IDENTITY_AUTO_DISCOVERY = 'false'",
      "$env:FOLEA_COMMIT_SHA = 'e80b00ba257bde6b05b9cfaea20046a0270ecc85'",
      "$env:FOLEA_COMMIT_COUNT = '69'",
      "$env:FOLEA_BUILD_TIMESTAMP = '20260719070635'",
      "$env:FOLEA_SOURCE_BRANCH = 'develop'",
      "$env:FOLEA_WORKFLOW_RUN_URL = 'https://github.com/ivanovanatoliy/folea/actions/runs/29677544400'",
      "$builtVersion = node scripts/prepare-development-build.mjs",
      "if ($builtVersion -ne '0.0.0-git.20260719070635.c00000069.e80b00b') { throw \"Unexpected build version: $builtVersion\" }",
      "npm ci",
      "npm version $builtVersion --no-git-tag-version --allow-same-version",
      "npm run build",
      "npx electron-builder --dir --win --x64 --publish never",
      "Pop-Location",
      "Move-Item -LiteralPath (Join-Path $dir 'dist\\win-unpacked') -Destination (Join-Path $dir 'app')",
      "Get-ChildItem -LiteralPath $dir -Force | Where-Object Name -ne 'app' | Remove-Item -Recurse -Force"
    ]
  },
  "bin": [
    [
      "app\\folea.exe",
      "folea"
    ]
  ],
  "shortcuts": [
    [
      "app\\folea.exe",
      "folea"
    ]
  ]
}
