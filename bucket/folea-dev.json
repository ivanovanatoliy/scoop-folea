      "hash": "94931d7067782782636ea791c4690136a9cf24e0b4ddf751710947a74bfc93c4",
      "extract_dir": "folea-8679baa52f85512807afa67a5727fe059a5cce1c"
    }
  },
  "depends": "nodejs22",
  "installer": {
    "script": [
      "Push-Location $dir",
      "$env:CSC_IDENTITY_AUTO_DISCOVERY = 'false'",
      "$env:FOLEA_COMMIT_SHA = '8679baa52f85512807afa67a5727fe059a5cce1c'",
      "$env:FOLEA_COMMIT_COUNT = '58'",
      "$env:FOLEA_BUILD_TIMESTAMP = '20260718181415'",
      "$env:FOLEA_SOURCE_BRANCH = 'develop'",
      "$env:FOLEA_WORKFLOW_RUN_URL = 'https://github.com/ivanovanatoliy/folea/actions/runs/29655465421'",
      "$builtVersion = node scripts/prepare-development-build.mjs",
      "if ($builtVersion -ne '0.0.0-git.20260718181415.c00000058.8679baa') { throw \"Unexpected build version: $builtVersion\" }",
      "npm ci",
      "npm version $builtVersion --no-git-tag-version --allow-same-version",
      "npm run build",
      "npx electron-builder --dir --win --x64 --publish never",
      "Pop-Location",
      "Move-Item -LiteralPath (Join-Path $dir 'dist\\win-unpacked') -Destination (Join-Path $dir 'app')",
      "Get-ChildItem -LiteralPath $dir -Force | Where-Object Name -ne 'app' | Remove-Item -Recurse -Force"
    ]
  },
  "bin": [["app\\folea.exe", "folea-dev"]],
  "shortcuts": [["app\\folea.exe", "Folea Dev"]]
}
