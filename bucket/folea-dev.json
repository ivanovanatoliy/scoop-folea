{
  "version": "0.0.0-git.20260719055247.c00000067.e922be5",
  "description": "Development build of Folea from commit e922be5",
  "homepage": "https://github.com/ivanovanatoliy/folea",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/ivanovanatoliy/folea/archive/e922be5003e374dd449fb80c95358fd464649c8f.zip",
      "hash": "cb8ed8c9e2fccdd85413240995b5f11deded9888689b0c6cfb649e4b2f280a5f",
      "extract_dir": "folea-e922be5003e374dd449fb80c95358fd464649c8f"
    }
  },
  "depends": "nodejs22",
  "installer": {
    "script": [
      "Push-Location $dir",
      "$env:CSC_IDENTITY_AUTO_DISCOVERY = 'false'",
      "$env:FOLEA_COMMIT_SHA = 'e922be5003e374dd449fb80c95358fd464649c8f'",
      "$env:FOLEA_COMMIT_COUNT = '67'",
      "$env:FOLEA_BUILD_TIMESTAMP = '20260719055247'",
      "$env:FOLEA_SOURCE_BRANCH = 'develop'",
      "$env:FOLEA_WORKFLOW_RUN_URL = 'https://github.com/ivanovanatoliy/folea/actions/runs/29675521399'",
      "$builtVersion = node scripts/prepare-development-build.mjs",
      "if ($builtVersion -ne '0.0.0-git.20260719055247.c00000067.e922be5') { throw \"Unexpected build version: $builtVersion\" }",
      "npm ci",
      "npm version $builtVersion --no-git-tag-version --allow-same-version",
      "npm run build",
      "npx electron-builder --dir --win --x64 --publish never",
      "Pop-Location",
      "Move-Item -LiteralPath (Join-Path $dir 'dist\\win-unpacked') -Destination (Join-Path $dir 'app')",
      "Get-ChildItem -LiteralPath $dir -Force | Where-Object Name -ne 'app' | Remove-Item -Recurse -Force"
    ]
  },
  "bin": [["app\\folea.exe", "folea-dev"]],
  "shortcuts": [["app\\folea.exe", "Folea Dev"]]
}
