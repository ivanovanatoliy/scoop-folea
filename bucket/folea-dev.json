{
  "version": "0.0.0-git.20260725050339.c00000076.0826dc6",
  "description": "Keyboard-driven, minimalist note manager for Typst notes",
  "homepage": "https://github.com/ivanovanatoliy/folea",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/ivanovanatoliy/folea/archive/0826dc634b4ddb82cd19023a578fc1dc8a853f47.zip",
      "hash": "dca6a19f7e768611cd6df9635d1b4e9b511876b21b9fdb2b45c1cb23cf5be4ce",
      "extract_dir": "folea-0826dc634b4ddb82cd19023a578fc1dc8a853f47"
    }
  },
  "depends": "nodejs22",
  "installer": {
    "script": [
      "Push-Location $dir",
      "$env:CSC_IDENTITY_AUTO_DISCOVERY = 'false'",
      "$env:FOLEA_COMMIT_SHA = '0826dc634b4ddb82cd19023a578fc1dc8a853f47'",
      "$env:FOLEA_COMMIT_COUNT = '76'",
      "$env:FOLEA_BUILD_TIMESTAMP = '20260725050339'",
      "$env:FOLEA_SOURCE_BRANCH = 'develop'",
      "$env:FOLEA_WORKFLOW_RUN_URL = 'https://github.com/ivanovanatoliy/folea/actions/runs/30145090988'",
      "$builtVersion = node scripts/prepare-development-build.mjs",
      "if ($builtVersion -ne '0.0.0-git.20260725050339.c00000076.0826dc6') { throw \"Unexpected build version: $builtVersion\" }",
      "npm ci",
      "npm version $builtVersion --no-git-tag-version --allow-same-version",
      "npm run build",
      "npx electron-builder --dir --win --x64 --publish never",
      "Pop-Location",
      "Move-Item -LiteralPath (Join-Path $dir 'dist\\win-unpacked') -Destination (Join-Path $dir 'app')",
      "Get-ChildItem -LiteralPath $dir -Force | Where-Object Name -ne 'app' | Remove-Item -Recurse -Force"
    ]
  },
  "bin": [["app\\folea.exe", "folea"]],
  "shortcuts": [["app\\folea.exe", "folea"]]
}
