{
  "version": "0.0.0-git.20260725132240.c00000080.28bfa26",
  "description": "Keyboard-driven, minimalist note manager for Typst notes",
  "homepage": "https://github.com/ivanovanatoliy/folea",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/ivanovanatoliy/folea/archive/28bfa26e6f7451789bb445c61bc6f9a42fec8362.zip",
      "hash": "9d2af9d1985ec8766bc35eeb01e6e5adf53a2eb7f9cee35ab0bfe5a52380810f",
      "extract_dir": "folea-28bfa26e6f7451789bb445c61bc6f9a42fec8362"
    }
  },
  "depends": "nodejs22",
  "installer": {
    "script": [
      "Push-Location $dir",
      "$env:CSC_IDENTITY_AUTO_DISCOVERY = 'false'",
      "$env:FOLEA_COMMIT_SHA = '28bfa26e6f7451789bb445c61bc6f9a42fec8362'",
      "$env:FOLEA_COMMIT_COUNT = '80'",
      "$env:FOLEA_BUILD_TIMESTAMP = '20260725132240'",
      "$env:FOLEA_SOURCE_BRANCH = 'develop'",
      "$env:FOLEA_WORKFLOW_RUN_URL = 'https://github.com/ivanovanatoliy/folea/actions/runs/30159609040'",
      "$legacyStartMenu = if ($global) { [Environment]::GetFolderPath('CommonStartMenu') } else { [Environment]::GetFolderPath('StartMenu') }",
      "Remove-Item -LiteralPath (Join-Path $legacyStartMenu 'Programs\\Scoop Apps\\Folea Dev.lnk') -Force -ErrorAction SilentlyContinue",
      "$builtVersion = node scripts/prepare-development-build.mjs",
      "if ($builtVersion -ne '0.0.0-git.20260725132240.c00000080.28bfa26') { throw \"Unexpected build version: $builtVersion\" }",
      "npm ci",
      "npm version $builtVersion --no-git-tag-version --allow-same-version",
      "npm run build",
      "npx electron-builder --dir --win --x64 --publish never",
      "Pop-Location",
      "Move-Item -LiteralPath (Join-Path $dir 'dist\\win-unpacked') -Destination (Join-Path $dir 'app')",
      "Get-ChildItem -LiteralPath $dir -Force | Where-Object Name -ne 'app' | Remove-Item -Recurse -Force"
    ]
  },
  "pre_uninstall": [
    "$legacyStartMenu = if ($global) { [Environment]::GetFolderPath('CommonStartMenu') } else { [Environment]::GetFolderPath('StartMenu') }",
    "Remove-Item -LiteralPath (Join-Path $legacyStartMenu 'Programs\\Scoop Apps\\Folea Dev.lnk') -Force -ErrorAction SilentlyContinue"
  ],
  "bin": [["app\\folea.exe", "folea"]],
  "shortcuts": [["app\\folea.exe", "folea"]]
}
