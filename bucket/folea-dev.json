{
  "version": "0.0.0-git.20260725054031.c00000077.e2f62c1",
  "description": "Keyboard-driven, minimalist note manager for Typst notes",
  "homepage": "https://github.com/ivanovanatoliy/folea",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/ivanovanatoliy/folea/archive/e2f62c15aa87f0334218a07d1a93c5f63671bbec.zip",
      "hash": "de1ebdc4b9063ed653498d3fbc0e2a2c922b50724543a159b0c20ad0740b9f2d",
      "extract_dir": "folea-e2f62c15aa87f0334218a07d1a93c5f63671bbec"
    }
  },
  "depends": "nodejs22",
  "installer": {
    "script": [
      "Push-Location $dir",
      "$env:CSC_IDENTITY_AUTO_DISCOVERY = 'false'",
      "$env:FOLEA_COMMIT_SHA = 'e2f62c15aa87f0334218a07d1a93c5f63671bbec'",
      "$env:FOLEA_COMMIT_COUNT = '77'",
      "$env:FOLEA_BUILD_TIMESTAMP = '20260725054031'",
      "$env:FOLEA_SOURCE_BRANCH = 'develop'",
      "$env:FOLEA_WORKFLOW_RUN_URL = 'https://github.com/ivanovanatoliy/folea/actions/runs/30146169247'",
      "$builtVersion = node scripts/prepare-development-build.mjs",
      "if ($builtVersion -ne '0.0.0-git.20260725054031.c00000077.e2f62c1') { throw \"Unexpected build version: $builtVersion\" }",
      "npm ci",
      "npm version $builtVersion --no-git-tag-version --allow-same-version",
      "npm run build",
      "npx electron-builder --dir --win --x64 --publish never",
      "Pop-Location",
      "Move-Item -LiteralPath (Join-Path $dir 'dist\\win-unpacked') -Destination (Join-Path $dir 'app')",
      "Get-ChildItem -LiteralPath $dir -Force | Where-Object Name -ne 'app' | Remove-Item -Recurse -Force"
    ]
  },
  "bin": [["app\\folea.exe", "folea"]],
  "shortcuts": [["app\\folea.exe", "folea"]]
}
